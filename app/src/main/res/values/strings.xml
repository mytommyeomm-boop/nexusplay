    <!-- Mascot, welcome, tutorials, notices -->
    <string name="welcome_title">Welcome to NexusPlay!</string>
    <string name="welcome_body">Hi, I am your NexusPlay helper! NexusPlay organizes your PC game files and hands them to Winlator Cmod to run. Some parts of the app are still being built, and I will always tell you which ones are ready.</string>
    <string name="welcome_start">Show me around</string>
    <string name="welcome_skip">Skip for now</string>
    <string name="welcome_footer">You can replay this any time in Settings > Mascot.</string>
